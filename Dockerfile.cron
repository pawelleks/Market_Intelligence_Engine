# Cron Service Dockerfile
FROM python:3.10-slim

WORKDIR /app

# Install dependencies (same as backend to ensure scripts run)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir \
    --trusted-host pypi.org \
    --trusted-host files.pythonhosted.org \
    --trusted-host pypi.python.org \
    -r requirements.txt

# Install Supercronic
ENV SUPERCRONIC_URL=https://github.com/aptible/supercronic/releases/download/v0.2.29/supercronic-linux-amd64 \
    SUPERCRONIC=supercronic-linux-amd64 \
    SUPERCRONIC_SHA1SUM=cd48d45c4b10f3f0bfdd3a57d054cd05ac96812b

RUN curl -fsSLO "$SUPERCRONIC_URL" \
    && echo "$SUPERCRONIC_SHA1SUM  $SUPERCRONIC" | sha1sum -c - \
    && chmod +x "$SUPERCRONIC" \
    && mv "$SUPERCRONIC" "/usr/local/bin/${SUPERCRONIC}" \
    && ln -s "/usr/local/bin/${SUPERCRONIC}" /usr/local/bin/supercronic

# Copy Source & Script
# Copy Source & Script
COPY src/ ./src/
# Copy prompts (required for AI features)
COPY prompts/ ./prompts/
COPY cli/ ./cli/
# Orchestrator script is now in cli/orchestrator.sh
RUN chmod +x cli/orchestrator.sh
# Copy scripts folder
COPY scripts/ ./scripts/
RUN chmod +x scripts/economic_cron.sh
# Copy jobs folder (daily pipeline jobs)
COPY jobs/ ./jobs/
# Copy config folder (macro_series.yml etc.)
COPY config/ ./config/

# Create crontab
# 17:00 EST = 22:00 UTC (Standard)
# 0 22 * * *
RUN echo "0 22 * * * /app/cli/orchestrator.sh CRON >> /proc/1/fd/1 2>&1" > crontab && \
    echo "10 22 * * * python /app/jobs/process_expected_moves_static.py >> /proc/1/fd/1 2>&1" >> crontab && \
    echo "30 22 * * * python /app/jobs/fetch_market_eod_chains.py >> /proc/1/fd/1 2>&1" >> crontab && \
    echo "35 22 * * * python /app/jobs/process_implied_probabilities.py >> /proc/1/fd/1 2>&1" >> crontab && \
    echo "0 3 * * * /app/scripts/economic_cron.sh >> /proc/1/fd/1 2>&1" >> crontab

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Run Supercronic
CMD ["supercronic", "crontab"]
