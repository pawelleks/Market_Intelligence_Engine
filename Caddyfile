{
    auto_https off
}

http://localhost, http://127.0.0.1 {
    header {
        X-Xss-Protection "1; mode=block"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy /api/* mie-api:8000
    reverse_proxy * mie-web:80
}

# Production domains are managed separately on the server.
# Do NOT add blindmonkey.io / TLS blocks here — causes ERR_SSL_PROTOCOL_ERROR locally.
