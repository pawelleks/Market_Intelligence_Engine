# =============================================================================
# Market Intelligence Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Environment-specific overrides: .env.local, .env.staging, .env.prod
# =============================================================================

# --- Caddy / Deployment ---
# Which Caddyfile to mount: Caddyfile.local | Caddyfile.staging | Caddyfile.prod
CADDYFILE=Caddyfile.local

# --- Auth ---
# Set to "true" to disable Google OAuth (auto-bypass login)
VITE_DISABLE_AUTH=false
GOOGLE_CLIENT_ID=
JWT_SECRET_KEY=

# --- Data Providers ---
POLYGON_API_KEY=
MASSIVE_API_KEY=
THETADATA_USERNAME=
THETADATA_PASSWORD=
THETA_HOST=theta_terminal

# --- AI / LLM ---
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o

# --- FRED (Macro Data) ---
FRED_API_KEY=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# --- Remote Deploy (optional, used by scripts/deploy_safe.sh) ---
# REMOTE_USER=
# REMOTE_HOST=
# IDENTITY_FILE=
# SSH_PORT=22
