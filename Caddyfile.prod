blindmonkey.io {
    header {
        X-Xss-Protection "1; mode=block"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy /api/* mie-api:8000
    reverse_proxy * mie-web:80
}

www.blindmonkey.io {
    redir https://blindmonkey.io{uri} permanent
}
